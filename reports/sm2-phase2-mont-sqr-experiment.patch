+/* Phase 2 A/B helper: squaring expressed through the generic multiplier. */
+static void sqr_via_mul_generic(const felem a, felem r) {
+    mont_mul_generic(a, a, r);
+}
+
+static int check_sqr(const felem a, uint64_t index) {
+    felem expected, actual, alias;
+    mont_mul_generic(a, a, expected);
+    mont_sqr_generic(a, actual);
+    if (memcmp(expected, actual, sizeof(felem)) != 0) {
+        printf("FAIL: mont_sqr_generic mismatch at case %" PRIu64 "\n", index);
+        print_felem("a", a);
+        print_felem("mul(a,a)", expected);
+        print_felem("sqr(a)", actual);
+        return 0;
+    }
+    felem_copy(alias, a);
+    mont_sqr_generic(alias, alias);
+    if (memcmp(expected, alias, sizeof(felem)) != 0) {
+        printf("FAIL: mont_sqr_generic output aliases input at case %" PRIu64
+               "\n", index);
+        return 0;
+    }
+    return 1;
+}
+
+static int test_montgomery_sqr(uint64_t random_cases) {
+    const felem edge[] = {
+        {0, 0, 0, 0},
+        {1, 0, 0, 0},
+        {UINT64_C(0xfffffffffffffffe), UINT64_C(0xffffffff00000000),
+         UINT64_MAX, UINT64_C(0xfffffffeffffffff)},
+        {0, 0, 0, UINT64_C(0x8000000000000000)},
+        {UINT64_C(0xaaaaaaaaaaaaaaaa), UINT64_C(0x5555555555555555),
+         UINT64_C(0xaaaaaaaaaaaaaaaa), UINT64_C(0x5555555555555555)},
+        {UINT64_C(0x5555555555555555), UINT64_C(0xaaaaaaaaaaaaaaaa),
+         UINT64_C(0x5555555555555555), UINT64_C(0xaaaaaaaaaaaaaaaa)},
+        {UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX}
+    };
+    uint64_t index = 0;
+    for (size_t i = 0; i < sizeof(edge) / sizeof(edge[0]); ++i) {
+        if (!check_sqr(edge[i], index++)) return 0;
+    }
+
+    for (uint64_t i = 0; i < random_cases; ++i) {
+        felem a;
+        random_felem(a);
+        if (!check_sqr(a, index++)) return 0;
+    }
+    printf("PASS: Montgomery sqr differential (%" PRIu64
+           " cases plus alias checks)\n", index);
+    return 1;
+}
