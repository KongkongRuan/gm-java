+/* Dedicated Montgomery square (SOS): exploits the a*a symmetry (10 unique
+ * 64x64 products instead of 16), then applies the same SM2-prime special-
+ * form Montgomery reduction as DEFINE_MONT_MUL. Alias-safe with the input. */
+static void mont_sqr_generic(const felem a, felem r) {
+    /* 1) cross terms sum_{i<j} a_i*a_j, each added once */
+    uint64_t t[8] = {0, 0, 0, 0, 0, 0, 0, 0};
+    for (int i = 0; i < 3; i++) {
+        uint128_t c = 0;
+        for (int j = i + 1; j < 4; j++) {
+            int k = i + j;
+            c += (uint128_t)a[i] * a[j] + t[k];
+            t[k] = (uint64_t)c;
+            c >>= 64;
+        }
+        for (int k = i + 4; c && k < 8; k++) {
+            c += t[k]; t[k] = (uint64_t)c; c >>= 64;
+        }
+    }
+    /* 2) t = 2 * cross  (2*cross = a^2 - diag < 2^512, so no bit 512) */
+    uint64_t cry = 0;
+    for (int k = 0; k < 8; k++) {
+        uint64_t nc = t[k] >> 63;
+        t[k] = (t[k] << 1) | cry;
+        cry = nc;
+    }
+    /* 3) add the diagonal squares a_i^2: t = a^2 < p^2 */
+    for (int i = 0; i < 4; i++) {
+        uint128_t c = (uint128_t)a[i] * a[i] + t[2*i];
+        t[2*i] = (uint64_t)c; c >>= 64;
+        for (int k = 2*i + 1; c && k < 8; k++) {
+            c += t[k]; t[k] = (uint64_t)c; c >>= 64;
+        }
+    }
+
+    /* 4) Montgomery reduction, m = z[0] (p' = 1), SM2 special form:
+     * p0=p2=2^64-1, p1=2^64-2^32, p3=2^64-2^32-1 -- no multiplies. */
+    uint64_t z0=t[0], z1=t[1], z2=t[2], z3=t[3],
+            z4=t[4], z5=t[5], z6=t[6], z7=t[7];
+    for (int i = 0; i < 4; i++) {
+        uint64_t m = z0;
+        uint128_t carry = m; /* m*p0 + z0 = m*2^64, high word = m */
+        carry += (uint128_t)z1 + (((uint128_t)m << 64) - ((uint128_t)m << 32));
+        z1 = (uint64_t)carry; carry >>= 64;
+        carry += (uint128_t)z2 + (((uint128_t)m << 64) - (uint128_t)m);
+        z2 = (uint64_t)carry; carry >>= 64;
+        carry += (uint128_t)z3 + (((uint128_t)m << 64) - ((uint128_t)m << 32) - (uint128_t)m);
+        z3 = (uint64_t)carry; carry >>= 64;
+        uint128_t c1 = (uint64_t)carry;
+        c1 += z4; z4 = (uint64_t)c1; c1 >>= 64;
+        c1 += z5; z5 = (uint64_t)c1; c1 >>= 64;
+        c1 += z6; z6 = (uint64_t)c1; c1 >>= 64;
+        c1 += z7; z7 = (uint64_t)c1;
+        /* shift right by 1 limb */
+        z0=z1; z1=z2; z2=z3; z3=z4; z4=z5; z5=z6; z6=z7; z7=0;
+    }
+
+    /* conditional subtraction: if z >= p, z -= p */
+    uint64_t d[4];
+    int128_t bw = (int128_t)z0 - P64[0]; d[0]=(uint64_t)bw; bw>>=64;
+    bw += (int128_t)z1 - P64[1];         d[1]=(uint64_t)bw; bw>>=64;
+    bw += (int128_t)z2 - P64[2];         d[2]=(uint64_t)bw; bw>>=64;
+    bw += (int128_t)z3 - P64[3];         d[3]=(uint64_t)bw; bw>>=64;
+    bw += z4;
+    uint64_t mask = (uint64_t)((int64_t)bw >> 63);
+    r[0] = (z0 & mask) | (d[0] & ~mask);
+    r[1] = (z1 & mask) | (d[1] & ~mask);
+    r[2] = (z2 & mask) | (d[2] & ~mask);
+    r[3] = (z3 & mask) | (d[3] & ~mask);
+}
