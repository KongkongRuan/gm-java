# ignore these folders
target/
.idea/
.settings/
.vscode/
bin/
out/
.workbuddy/
.tmp_research/
.tmp_check/

# temporary diff / classpath files generated by tools
.tmp_diff_*.txt
cp.txt

# ignore these files
.classpath
.project
.settings
.idea

# filter databfile、sln file
*.mdb
*.ldb
*.sln

# class file
*.com
*.class
*.dll
*.exe
*.o
*.so
# but keep bundled native libraries
!src/main/resources/native/**/*.dll
!src/main/resources/native/**/*.so
!src/main/resources/native/**/*.dylib

# compression file
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip
*.via
*.tmp
*.err
*.log
*.iml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?
ehthumbs.db
Thumbs.db
.factorypath
.mvn/
mvnw.cmd
mvnw

# Files or folders need to be retained
# ...
/src/test/

# Keep benchmark reports (override global *.log)
!reports/
!reports/**/*.log
!reports/**/*.md

# ignore JFR binary recordings
reports/profiling/*.jfr

